---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/custom-pico.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "ZFRQBL", description = "hobby coder | Lovecraft Enthusiast | The Truth is Out There" } = Astro.props;
---

<!usr/bin/env html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="alternate" type="application/rss+xml" title="ZFRQBL RSS Feed" href="/rss.xml" />
</head>
<body>
  <Header />
  <main class="container">
    <slot />
  </main>
  <Footer />
</body>
</html>
